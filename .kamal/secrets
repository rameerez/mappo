# No secret values in this repo: each is read on the deploying Mac from
# ~/.config/php-hosting/ (folder 700, files 600). Where else each one lives:
# https://github.com/rameerez/php-hosting/blob/main/docs/DECISIONS.md#d24-secrets-outside-the-repo-on-the-deploying-mac

AWS_ECR_PASSWORD=$(aws ecr get-login-password --region us-east-1)

# Cloudflare Origin CA cert for mappojs.com + *.mappojs.com (bin/origin-cert mappojs.com).
TLS_CERTIFICATE_PEM=$(cat ~/.config/php-hosting/certs/mappojs.com.pem)
TLS_PRIVATE_KEY_PEM=$(cat ~/.config/php-hosting/certs/mappojs.com.key)

