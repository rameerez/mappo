# No secret values in this repo. TLS cert/key are in config/secrets.sops.yaml
# (sops + age; key ~/.config/php-hosting/age.key), read with php-hosting's
# bin/secret. Checked before every deploy by .kamal/hooks/pre-connect.
# https://github.com/rameerez/php-hosting/blob/main/docs/SECRETS-PLAN.md

AWS_ECR_PASSWORD=$(aws ecr get-login-password --region us-east-1)

# Cloudflare Origin CA cert for this site (15 years).
TLS_CERTIFICATE_PEM=$(~/GitHub/php-hosting/bin/secret config/secrets.sops.yaml tls_certificate)
TLS_PRIVATE_KEY_PEM=$(~/GitHub/php-hosting/bin/secret config/secrets.sops.yaml tls_private_key)
