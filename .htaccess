# mappojs.com on Apache. The pages are static; this is the little the server
# needs to serve them well. Deployed with the site by deploy.sh.

# Types Apache's default table lacks here: the landing's captures, and the
# orbital-element files the satellite demos fetch as text.
AddType image/webp .webp
AddType text/plain .tle

# Caching: everything the site is made of revalidates on every visit (a 304
# with an ETag is cheap, a stale module is not: a deploy must show at once,
# and Cloudflare turned a one-hour max-age into four). Only images and the
# orbital-element files, which change rarely, may sit for a day.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(webp|png|svg|ico|tle)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json text/plain
</IfModule>
